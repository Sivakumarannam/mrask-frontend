# =============================================================================
# BACKEND ENVIRONMENT VARIABLES — copy this file to .env and fill in values
# =============================================================================
# DO NOT commit the real .env file to version control!
# This .env.example is safe to commit — it contains no real secrets.
# For production, set all these values in the Render dashboard.

# --- Django Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- CORS / CSRF (add your production domains here) ---
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000

# --- PostgreSQL (delete/comment out to use SQLite for local dev) ---
# POSTGRES_DB=portfolio
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_postgres_password
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Gmail SMTP (for contact form emails) ---
# 1. Use a Gmail account dedicated to the app.
# 2. Enable 2-Step Verification on that account.
# 3. Go to myaccount.google.com → Security → App passwords → generate 16-char code.
# 4. Paste the 16-char code (with spaces) below.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=your-gmail@gmail.com
CONTACT_EMAIL_TO=your-personal-inbox@gmail.com

# --- AI / RAG (optional) ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b
# RAG_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
